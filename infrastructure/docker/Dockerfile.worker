# syntax=docker/dockerfile:1
# ---- Sada Worker (background jobs) — includes ffmpeg for transcoding ----
# Install the FULL frozen dependency tree (bun.lock) so prisma/sharp/etc.
# versions match the tested monorepo exactly (avoids latest-major drift).
FROM oven/bun:1
WORKDIR /srv
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY package.json bun.lock ./
COPY prisma ./prisma
RUN bun install --frozen-lockfile
RUN bunx prisma generate
COPY src ./src
COPY mini-services/worker/index.ts ./index.ts
COPY mini-services/worker/src ./worker-src
CMD ["bun", "index.ts"]
